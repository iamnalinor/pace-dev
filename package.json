{
  "name": "template",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": {
    "packages": [
      "apps/*"
    ],
    "catalog": {
      "@elysiajs/eden": "1.4.9",
      "@types/bun": "1.4.2",
      "better-auth": "1.7.6",
      "elysia": "1.4.30",
      "typescript": "6.0.3",
      "vite": "8.3.1",
      "vitest": "5.0.2"
    }
  },
  "scripts": {
    "dev": "bun run --filter '@template/*' dev",
    "build": "bun run --filter '@template/web' build",
    "lint": "bun run lint:format && bun run lint:eslint && bun run typecheck && bun run lint:knip && bun run lint:dup && bun run lint:arch && bun run db:check",
    "lint:format": "biome format --write .",
    "lint:eslint": "eslint . --fix --max-warnings 0 --cache --cache-location .cache/eslint/",
    "lint:knip": "knip --no-progress",
    "lint:dup": "jscpd",
    "lint:arch": "depcruise apps e2e --config .dependency-cruiser.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/api && tsc -p apps/web && tsc -p e2e",
    "test": "bun run test:unit && bun run test:integration && bun run test:e2e",
    "test:unit": "bun run --cwd apps/api test:unit && bun run --cwd apps/web test:unit",
    "test:integration": "bun run --cwd apps/api test:integration",
    "test:e2e": "playwright test",
    "test:mutation": "bun run --cwd apps/web test:mutation",
    "db:generate": "bun run --cwd apps/api db:generate",
    "db:migrate": "bun run --cwd apps/api db:migrate",
    "db:check": "bun run --cwd apps/api db:check",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.14",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint-react/eslint-plugin": "5.20.8",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tsconfig/strictest": "2.0.8",
    "@types/bun": "catalog:",
    "@vitest/eslint-plugin": "1.6.27",
    "dependency-cruiser": "18.4.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-better-tailwindcss": "4.7.0",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-functional": "10.0.1",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-perfectionist": "5.12.1",
    "eslint-plugin-playwright": "2.12.0",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-regexp": "3.3.1",
    "eslint-plugin-security": "4.0.1",
    "eslint-plugin-sonarjs": "4.2.1",
    "eslint-plugin-testing-library": "7.16.2",
    "eslint-plugin-unicorn": "76.0.0",
    "jiti": "2.7.0",
    "jscpd": "5.3.2",
    "knip": "6.38.0",
    "lefthook": "2.1.14",
    "typescript": "catalog:",
    "typescript-eslint": "8.70.1"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0",
    "qs": "6.16.0"
  }
}
