{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pace-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "pace-api.nalinor.dev", "custom_domain": true }],
  "observability": { "enabled": true },
  // Secrets (set with `wrangler secret put`, never here): TELEGRAM_BOT_TOKEN (from @BotFather),
  // TELEGRAM_WEBHOOK_SECRET (random string echoed by Telegram on every webhook call).
  // Optional vars set at deploy time: BOT_INFO (JSON of getMe), TELEGRAM_API_ROOT (tests only).
  // All are typed in src/shared/env.d.ts and parsed by src/shared/config.ts.
  "vars": {
    "ENVIRONMENT": "production",
    // Telegram user ids allowed to sign in (comma separated). Other deployments edit this.
    "ALLOWED_TELEGRAM_IDS": "1919230638",
    "TELEGRAM_BOT_USERNAME": "PaceTaskTrackerBot",
    "WEB_ORIGIN": "https://pace.nalinor.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pace",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle/d1"
    }
  ],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "79653b9423324ba89a917eae8a8278a3" }],
  "durable_objects": {
    "bindings": [{ "name": "USER_STORE", "class_name": "UserStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserStore"] }],
  "dev": { "port": 8787 },
  "env": {
    "dev": {
      // Local/e2e environment: no custom domain, local D1/KV/DO emulation.
      "routes": [],
      "vars": {
        "ENVIRONMENT": "development",
        "ALLOWED_TELEGRAM_IDS": "1919230638",
        "TELEGRAM_BOT_USERNAME": "PaceTaskTrackerBot",
        "WEB_ORIGIN": "http://localhost:5173"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "pace",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "drizzle/d1"
        }
      ],
      "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "00000000000000000000000000000000" }],
      "durable_objects": {
        "bindings": [{ "name": "USER_STORE", "class_name": "UserStore" }]
      }
    }
  }
}
