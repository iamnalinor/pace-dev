{
  "name": "@template/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/contract.ts"
  },
  "scripts": {
    "dev": "TZ=UTC bun --env-file=../../.env --watch src/main.ts",
    "start": "TZ=UTC bun --env-file=../../.env src/main.ts",
    "test:unit": "TZ=UTC bun test ./src",
    "test:integration": "TZ=UTC TESTCONTAINERS_RYUK_DISABLED=true bun test ./tests/integration --preload ./tests/integration/preload.ts --timeout 30000",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "TZ=UTC bun --env-file=../../.env src/scripts/migrate.ts",
    "db:check": "bun src/scripts/check-migrations.ts",
    "test:coverage": "TZ=UTC TESTCONTAINERS_RYUK_DISABLED=true bun test ./src ./tests/integration --preload ./tests/integration/preload.ts --timeout 30000 --coverage"
  },
  "dependencies": {
    "@elysiajs/openapi": "1.4.16",
    "@sinclair/typebox": "0.34.52",
    "better-auth": "catalog:",
    "drizzle-orm": "0.45.3",
    "elysia": "catalog:",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@elysiajs/eden": "catalog:",
    "@testcontainers/postgresql": "12.2.0",
    "@types/bun": "catalog:",
    "drizzle-kit": "0.31.11",
    "fast-check": "4.10.2"
  }
}
