{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "pace-updates",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "r2_buckets": [{ "binding": "UPDATES", "bucket_name": "pace-updates" }]
}
