/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' https://telegram.org; frame-src https://oauth.telegram.org; img-src 'self' data: https://t.me https://telegram.org https://*.telegram.org; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' https://pace-api.nalinor.dev; manifest-src 'self'; worker-src 'self'
/.well-known/*
  Access-Control-Allow-Origin: *
