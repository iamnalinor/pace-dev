{
  "name": "@pace/app",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "imports": {
    "#app/*": "./src/*"
  },
  "scripts": {
    "dev": "expo start",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform android --no-install",
    "test": "jest",
    "build:web": "bun ../../scripts/build-web.ts",
    "serve:web": "bun ../../scripts/serve-web.ts",
    "deploy:web": "wrangler deploy --config wrangler.web.jsonc"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "0.4.2",
    "@expo/metro-runtime": "57.0.16",
    "@pace/client": "workspace:*",
    "@pace/core": "workspace:*",
    "expo": "57.0.27",
    "expo-background-task": "57.0.21",
    "expo-calendar": "57.0.5",
    "expo-constants": "57.0.21",
    "expo-font": "57.0.4",
    "expo-linking": "57.0.12",
    "expo-notifications": "57.0.22",
    "expo-router": "57.0.25",
    "expo-secure-store": "57.0.4",
    "expo-share-intent": "8.0.1",
    "expo-splash-screen": "57.0.9",
    "expo-sqlite": "57.0.4",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.4",
    "expo-task-manager": "57.0.21",
    "expo-web-browser": "57.0.3",
    "idb": "8.0.4",
    "lucide-react-native": "1.52.0",
    "nativewind": "4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.5",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.5",
    "react-native-web": "0.21.4",
    "react-native-worklets": "0.10.4",
    "workbox-window": "7.4.1",
    "write-excel-file": "4.1.1",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.5",
    "@types/react": "19.2.4",
    "babel-preset-expo": "57.0.14",
    "jest": "29.7.0",
    "jest-expo": "57.0.5",
    "tailwindcss": "3.4.19",
    "test-renderer": "1.3.0",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  },
  "jest": {
    "preset": "jest-expo",
    "cacheDirectory": "<rootDir>/../../.cache/jest",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^react$": "<rootDir>/node_modules/react",
      "^react/(.*)$": "<rootDir>/node_modules/react/$1",
      "^zustand$": "<rootDir>/node_modules/zustand",
      "^zustand/(.*)$": "<rootDir>/node_modules/zustand/$1",
      "^lucide-react-native$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/lucide-react-native.js"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(.bun|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|lucide-react-native|nativewind))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/react-native-worklets/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ]
  }
}
