# Copy to .env (git-ignored). Used by `bun dev` (API) and by `docker compose`.

# Local development (`docker compose up -d db` provides this database).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/template
# The URL users open. Dev: the Vite dev server. Compose: http://localhost:8080.
BETTER_AUTH_URL=http://localhost:5173
# At least 32 random characters: `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me-change-me-change-me-change-me

# docker compose only
POSTGRES_PASSWORD=postgres
PUBLIC_URL=http://localhost:8080
