# Pace — environment variables that are NOT Worker secrets (those go into
# apps/api/.dev.vars locally, see apps/api/.dev.vars.example).
#
# Each tool reads its own file: the Expo CLI (Android and the web build) reads apps/app/.env*,
# Playwright and the LLM scripts read the shell environment. `cp .env.example apps/app/.env`
# is enough for local development; export the others in your shell when you need them.

# ── The app (Expo CLI, apps/app/.env) ──────────────────────────────────────────
# API origin baked into the build (app.config.ts → extra.apiUrl). Defaults to production.
# The browser: http://localhost:8787. An emulator: http://10.0.2.2:8787. A device on the same
# network: your machine's LAN address.
EXPO_PUBLIC_API_URL=http://localhost:8787
# Username of the Telegram bot shown by the web Login Widget (no @).
EXPO_PUBLIC_TELEGRAM_BOT=PaceTaskTrackerBot
# 1 shows the dev login form in a production build (the e2e run uses it).
# EXPO_PUBLIC_DEV_LOGIN=1

# ── Playwright (shell) ─────────────────────────────────────────────────────────
# Run the e2e suite against an already running stack instead of starting wrangler dev + the web build.
# E2E_BASE_URL=http://localhost:4173
# Use an installed Chromium instead of `bunx playwright install` (sandboxes, CI images).
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=/usr/bin/chromium

# ── LLM regression, stage 2 (shell; `bun test:llm`) ────────────────────────────
# GROQ_API_KEY=
# GEMINI_API_KEY=
