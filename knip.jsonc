{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignoreIssues": {
    // Vendored shadcn/ui components export every sub-component (CardAction, ...);
    // we keep them close to upstream instead of trimming exports we don't use yet.
    "apps/web/src/shared/ui/**": ["exports", "types"],
    // Drizzle consumes these modules as a namespace (`import * as schema`).
    "apps/api/src/shared/db/d1-schema.ts": ["exports"],
    "apps/api/src/user-store/schema.ts": ["exports"]
  },
  "workspaces": {
    ".": {
      "entry": ["*.config.ts", "e2e/**/*.ts", "scripts/*.ts"]
    },
    "packages/core": {
      "project": ["src/**/*.ts"],
      // Stryker's command runner is built into @stryker-mutator/core.
      "ignoreDependencies": ["@stryker-mutator/command-runner"]
    },
    "packages/client": {
      "project": ["src/**/*.ts"]
    },
    "apps/api": {
      "entry": [
        "scripts/*.ts",
        "tests/**/*.ts",
        "drizzle.*.config.ts",
        // Referenced by path from the drizzle configs.
        "src/shared/db/d1-schema.ts",
        "src/user-store/schema.ts"
      ],
      "project": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"],
      // `cloudflare:workers` / `cloudflare:test` are runtime modules, not npm packages.
      "ignoreDependencies": ["cloudflare"]
    },
    "apps/web": {
      "ignoreDependencies": [
        "@stryker-mutator/command-runner",
        // Pre-declared for the web shell wiring (foundation phase B); drop from this list when used.
        "@pace/client",
        "@pace/core",
        "@tanstack/react-query",
        "idb",
        "lucide-react",
        "sonner",
        "zustand"
      ],
      "entry": ["src/test/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx,css}"]
    },
    "apps/app": {
      // Loading metro.config.js would execute NativeWind's Metro plugin (it writes files).
      "metro": false,
      "entry": ["plugins/*.js"],
      "project": ["app/**/*.{ts,tsx}", "plugins/*.js", "*.css"],
      "ignoreDependencies": [
        // The expo-font config plugin references these packages by file path in app.config.ts.
        "@expo-google-fonts/geist",
        "@expo-google-fonts/geist-mono",
        // Pre-declared for the app shell wiring (foundation phase B); drop from this list when used.
        "@pace/client",
        "lucide-react-native",
        "react-native-svg",
        "zustand"
      ]
    }
  }
}
