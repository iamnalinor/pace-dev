{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignoreIssues": {
    // Drizzle consumes these modules as a namespace (`import * as schema`).
    "apps/api/src/shared/db/d1-schema.ts": ["exports"],
    "apps/api/src/user-store/schema.ts": ["exports"]
  },
  "workspaces": {
    ".": {
      "entry": ["*.config.ts", "e2e/**/*.ts", "scripts/*.ts"]
    },
    "packages/core": {
      "project": ["src/**/*.ts"],
      // Stryker's command runner is built into @stryker-mutator/core.
      "ignoreDependencies": ["@stryker-mutator/command-runner"]
    },
    "packages/client": {
      "project": ["src/**/*.ts"]
    },
    "apps/api": {
      "entry": [
        "scripts/*.ts",
        "tests/**/*.ts",
        "drizzle.*.config.ts",
        // Referenced by path from the drizzle configs.
        "src/shared/db/d1-schema.ts",
        "src/user-store/schema.ts"
      ],
      "project": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"],
      // `cloudflare:workers` / `cloudflare:test` are runtime modules, not npm packages.
      "ignoreDependencies": ["cloudflare"]
    },
    "apps/app": {
      // Loading metro.config.js would execute NativeWind's Metro plugin (it writes files).
      "metro": false,
      // Local Expo modules are autolinked by folder; their index.ts is the JS entry.
      // The web build swaps in `*.web.ts(x)` siblings and src/platform/web (metro.config.js).
      "entry": [
        "plugins/*.js",
        "modules/*/index.ts",
        "src/**/*.web.{ts,tsx}",
        "src/platform/web/*.{ts,tsx}"
      ],
      "project": [
        "app/**/*.{ts,tsx}",
        "src/**/*.{ts,tsx}",
        "modules/**/*.ts",
        "plugins/*.js",
        "*.css"
      ],
      "ignoreDependencies": [
        // The expo-font config plugin references these packages by file path in app.config.ts.
        "@expo-google-fonts/inter"
      ]
    }
  }
}
