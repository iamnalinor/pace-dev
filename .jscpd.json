{
  "path": ["apps", "packages", "e2e"],
  "format": ["typescript", "tsx", "css"],
  "minTokens": 50,
  "threshold": 0,
  "absolute": true,
  "gitignore": true,
  "reporters": ["console"],
  "ignore": [
    "**/node_modules/**",
    "**/drizzle/**",
    "**/shared/ui/**",
    "**/tokens.css",
    "**/i18n/en/**",
    "**/i18n/ru/**",
    "**/worker-configuration.d.ts",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/tests/**",
    "apps/app/android/**",
    "e2e/**"
  ]
}
