      "html": "<div class=\"ds-tb\"><button class=\"ds-tb-btn ds-run\">Work</button><button class=\"ds-tb-btn ds-green\">Rest</button><button class=\"ds-tb-btn ds-off\">Calendar</button></div>",
      "css": ".ds-tb{font-family: Inter, system-ui, sans-serif;display:flex;gap:8px}.ds-tb-btn{flex:1;height:56px;border:2px solid;border-radius:14px;background:#141416;font-size:12px;line-height:14px;cursor:pointer}.ds-run{background:#4263eb;border-color:#4263eb;color:#fff;font-weight:500}.ds-green{border-color:#6fd49a;color:#6fd49a}.ds-off{border-style:dashed;border-color:rgba(255,255,255,.1);color:#8a8a93}.ds-tb-btn:active{opacity:.8}.ds-tb-btn:focus-visible{outline:2px solid #ececee;outline-offset:2px}"
