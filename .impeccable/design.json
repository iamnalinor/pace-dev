      "html": "<div class=\"ds-row\"><span class=\"ds-check\"></span><div class=\"ds-row-main\"><div class=\"ds-row-title\">Finish the quarterly report</div><div class=\"ds-meta\"><span class=\"ds-tag ds-tag-violet\">Work</span><span class=\"ds-tag ds-tag-coral\">ASAP</span><span>Due tomorrow 18:00 · <em>late</em></span></div><div class=\"ds-prog\"><i></i></div></div></div>",
      "css": ".ds-row{font-family: Inter, system-ui, sans-serif;display:flex;gap:12px;padding:12px;border-radius:12px}.ds-row:hover{background:#1c1c1f}.ds-check{flex:none;width:22px;height:22px;border:1.5px solid #8a8a93;border-radius:50%;box-sizing:border-box}.ds-row-main{flex:1;display:flex;flex-direction:column;gap:5px}.ds-row-title{font-size:15px;font-weight:500;color:#ececee}.ds-meta{display:flex;flex-wrap:wrap;align-items:center;gap:4px 6px;font-size:12px;line-height:16px;color:#8a8a93}.ds-meta em{font-style:normal;color:#ff8a5c}.ds-tag{padding:1px 6px;border-radius:8px;font-size:11px;font-weight:500;line-height:16px}.ds-tag-violet{background:rgba(180,156,255,.22);color:#b49cff}.ds-tag-coral{background:rgba(255,107,107,.22);color:#ff8a8a}.ds-prog{position:relative;height:3px;border-radius:8px;background:rgba(255,255,255,.12)}.ds-prog i{position:absolute;left:0;top:0;height:3px;width:30%;border-radius:8px;background:#ececee}"
